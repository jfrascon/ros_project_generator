{
  "folders": [
    {
      "path": ".",
      "name": "{{ project_id }}"
    },
  ],
  "settings": {
    "editor.autoIndent": "full",
    "editor.insertSpaces": true,
    "editor.tabSize": 2,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit"
    },
    "editor.detectIndentation": true,
    "editor.editContext": false,
    "explorer.excludeGitIgnore": false,
    "editor.formatOnPaste": true,
    "editor.formatOnSave": true,
    "editor.formatOnSaveMode": "modificationsIfAvailable",
    "editor.formatOnType": true,
    "editor.lineNumbers": "relative",
    "editor.rulers": [
      80,
      100,
      120
    ],
    "files.associations": {
      "*.config": "properties",
      "*.json": "jsonc",
      "*.launch": "xml",
      "*.sdf": "xml",
      "*.urdf": "xml",
      "*.xacro": "xml",
      "*.world": "xml",
      "*.j2": "jinja",
      "*.jinja": "jinja"
    },
    "files.autoSave": "onFocusChange",
    // List items to exclude from the file explorer.
    "files.exclude": {
      "**/.git": false,
      "**/.DS_Store": true,
      "**/__pycache__": true,
      "**/.pytest_cache": true,
      "**/.mypy_cache": true,
      "**/.ruff_cache": true,
      "**/.cache": true,
      "**/.idea": true,
      "**/CMakeFiles": true,
      "**/CMakeCache.txt": true,
      "**/Thumbs.db": true,
    },
    // List items to exclude from the file watcher (for performance reasons).
    "files.watcherExclude": {
      "**/build/**": true,
      "**/install/**": true,
      "**/devel/**": true,
      "**/log/**": true,
      "**/logs/**": true,
      "**/.git/**": true,
      "**/.svn/**": true,
      "**/.hg/**": true,
      "**/node_modules/**": true,
      "**/bower_components/**": true,
      "**/.pnpm-store/**": true,
      "**/.venv/**": true,
      "**/venv/**": true,
      "**/__pycache__/**": true,
      "**/.pytest_cache/**": true,
      "**/.mypy_cache/**": true,
      "**/.ruff_cache/**": true,
      "**/.cache/**": true,
      "**/.idea/**": true,
      "**/CMakeFiles/**": true
    },
    "files.saveConflictResolution": "overwriteFileOnDisk",
    "files.trimTrailingWhitespace": true,
    // List items to exclude from search results.
    "search.exclude": {
      "**/build": true,
      "**/install": true,
      "**/devel": true,
      "**/log": true,
      "**/logs": true,
      "**/.git": true,
      "**/.svn": true,
      "**/.hg": true,
      "**/node_modules": true,
      "**/bower_components": true,
      "**/.pnpm-store": true,
      "**/.venv": true,
      "**/venv": true,
      "**/__pycache__": true,
      "**/.pytest_cache": true,
      "**/.mypy_cache": true,
      "**/.ruff_cache": true,
      "**/.cache": true,
      "**/.idea": true,
      "**/CMakeFiles": true,
      "**/CMakeCache.txt": true,
      "**/*.code-search": true
    },
    // ==========================================================================
    // SHELL SETTINGS
    // NOTE: foxundermoon.shell-format requires shfmt: sudo apt install shfmt
    // NOTE: timonwong.shellcheck requires shellcheck: sudo apt install shellcheck
    // ==========================================================================
    "[shellscript]": {
      "editor.defaultFormatter": "lumirelle.shell-format-rev"
    },
    // Use 4-space indentation in shell scripts (shfmt -i 4).
    "shellformat.flag": "-i 4",
    // Run shellcheck on save, not on every keystroke.
    "shellcheck.run": "onSave",
    // ==========================================================================
    // CMAKE SETTINGS
    // ==========================================================================
    // Disable auto-configure: in ROS 2 the build is driven by colcon, not cmake directly.
    "cmake.configureOnOpen": false,
    "cmake.buildDirectory": "${workspaceFolder}/build/${buildType}",
    "cmake.generator": "Ninja",
    "[cmake]": {
      "editor.defaultFormatter": "cheshirekow.cmake-format",
      "editor.formatOnSave": false
    },
    "cmakeFormat.cwd": "${fileDirname}",
    // ==========================================================================
    // CPP SETTINGS
    // ==========================================================================
    "C_Cpp.intelliSenseEngine": "default",
    "C_Cpp.loggingLevel": "Warning",
    // Show squiggles in c_cpp_properties.json when configured paths do not exist.
    "C_Cpp.default.enableConfigurationSquiggles": true,
    "[c]": {
      "editor.defaultFormatter": "ms-vscode.cpptools"
    },
    "[cpp]": {
      "editor.defaultFormatter": "ms-vscode.cpptools"
    },
    "C_Cpp.formatting": "clangFormat",
    "C_Cpp.clang_format_style": "file",
    "C_Cpp.codeAnalysis.clangTidy.enabled": true,
    "C_Cpp.codeAnalysis.runAutomatically": false,
    "C_Cpp.codeAnalysis.clangTidy.path": "/usr/bin/clang-tidy",
    "C_Cpp.codeAnalysis.clangTidy.useBuildPath": true,
    // Configure glob patterns for excluding folders and files for code analysis.
    "C_Cpp.codeAnalysis.exclude": {
      "**/build": true,
      "**/devel": true,
      "**/install": true,
      "**/log": true,
      "**/.git": true
    },
    // ==========================================================================
    // PYTHON SETTINGS
    // ==========================================================================
    "python.analysis.autoFormatStrings": true,
    "python.analysis.diagnosticMode": "workspace",
    "python.analysis.extraPaths": [
      "/opt/ros/{{ ros_distro }}/lib/python{{ python_version }}/site-packages"
    ],
    "python.autoComplete.extraPaths": [
      "/opt/ros/{{ ros_distro }}/lib/python{{ python_version }}/site-packages"
    ],
    "python.analysis.typeCheckingMode": "standard",
    "python.analysis.useLibraryCodeForTypes": true,
    "[python]": {
      "editor.defaultFormatter": "charliermarsh.ruff",
      "editor.formatOnSave": true,
      "editor.formatOnSaveMode": "file",
      "editor.codeActionsOnSave": {
        "source.organizeImports": "never",
        "source.organizeImports.ruff": "always",
        "source.fixAll": "never",
        "source.fixAll.ruff": "always"
      }
    },
    // ==========================================================================
    // CODE SPELL CHECKER
    // ==========================================================================
    "cSpell.language": "en,es",
    "cSpell.ignorePaths": [
      "build/",
      "install/",
      "log/",
      "src/0_deps/"
    ],
    // ==========================================================================
    // DOX DOC GEN
    // ==========================================================================
    "doxdocgen.generic.authorName": "jfrascon",
    "doxdocgen.generic.authorEmail": "jfrascon@gmail.com",
    "doxdocgen.file.fileOrder": [
      "file",
      "brief",
      "author",
      "date"
    ],
    "doxdocgen.generic.order": [
      "brief",
      "param",
      "return"
    ],
    // ==========================================================================
    // ERROR LENS
    // ==========================================================================
    // Show inline diagnostics only for errors and warnings; hints are too noisy.
    "errorLens.enabledDiagnosticLevels": [
      "error",
      "warning"
    ],
    // Delay decoration updates to avoid flickering while typing.
    "errorLens.delay": 500,
    // ==========================================================================
    // GIT
    // ==========================================================================
    "git.autofetch": true,
    "git.ignoreLimitWarning": true,
    // ==========================================================================
    // ROS
    // ==========================================================================
    "ROS2.distro": "{{ ros_distro }}",
    // ==========================================================================
    // RUFF
    // ==========================================================================
    "ruff.configurationPreference": "filesystemFirst",
    "ruff.importStrategy": "fromEnvironment",
    // Turn off native-server (legacy ruff-lsp turned on).
    // Legacy ruff-lsp takes into account pyproject.toml files from submodules
    // when the field 'extend-exclude' is used in the top-level pyproject.toml
    // file (This is very convenient and native server does not support this
    // feature yet)
    "ruff.nativeServer": "off",
    "ruff.organizeImports": true,
    // ==========================================================================
    // YAML SETTINGS
    // ==========================================================================
    "[yaml]": {
      "editor.defaultFormatter": "redhat.vscode-yaml"
    },
    // Match the column ruler at 120.
    "yaml.format.printWidth": 120,
    // ==========================================================================
    // MARKDOWN SETTINGS
    // ==========================================================================
    "[markdown]": {
      "editor.defaultFormatter": "DavidAnson.vscode-markdownlint",
      "editor.formatOnSave": true
    },
    // ==========================================================================
    // TOML SETTINGS
    // ==========================================================================
    "[toml]": {
      "editor.defaultFormatter": "tamasfe.even-better-toml",
      "editor.formatOnSave": true,
      "editor.formatOnSaveMode": "file"
    },
    "evenBetterToml.formatter.alignEntries": false,
    "evenBetterToml.formatter.alignComments": true,
    "evenBetterToml.formatter.arrayTrailingComma": true,
    "evenBetterToml.formatter.arrayAutoExpand": true,
    "evenBetterToml.formatter.inlineTableExpand": true,
    "evenBetterToml.formatter.arrayAutoCollapse": true,
    "evenBetterToml.formatter.compactArrays": true,
    "evenBetterToml.formatter.compactInlineTables": false,
    "evenBetterToml.formatter.compactEntries": false,
    "evenBetterToml.formatter.columnWidth": 80,
    "evenBetterToml.formatter.indentTables": false,
    "evenBetterToml.formatter.indentEntries": false,
    "evenBetterToml.formatter.indentString": "  ",
    "evenBetterToml.formatter.trailingNewline": true,
    "evenBetterToml.formatter.reorderKeys": false,
    "evenBetterToml.formatter.reorderArrays": false,
    "evenBetterToml.formatter.reorderInlineTables": false,
    "evenBetterToml.formatter.allowedBlankLines": 2,
    "evenBetterToml.formatter.crlf": false,
    // ==========================================================================
    // XML SETTINGS
    // ==========================================================================
    "[xml]": {
      "editor.defaultFormatter": "redhat.vscode-xml"
    },
    "xml.format.maxLineWidth": 0,
    "xml.format.splitAttributes": "preserve",
    "xml.format.closingBracketNewLine": false,
    "xml.format.spaceBeforeEmptyCloseTag": false,
  }
}
